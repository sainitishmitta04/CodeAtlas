# Copy values into the repository-root .env (CodeAtlas reads ../.env). Names only.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
NEO4J_URI=neo4j+s://<instance>.databases.neo4j.io
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=
