# Frontend settings only. Never put secrets here: everything prefixed VITE_ is shipped to the browser.
# Where the browser sends API requests (default "/api", forwarded by the Vite proxy).
# VITE_API_BASE=/api
# Where the Vite dev/preview proxy forwards /api (default http://127.0.0.1:8000).
# CODEATLAS_API_URL=http://127.0.0.1:8000
